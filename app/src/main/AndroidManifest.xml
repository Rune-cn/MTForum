<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <uses-sdk tools:overrideLibrary="
        com.xzakota.hyper.notification.focus,
        top.yukonga.miuix.kmp.blur,
        top.yukonga.miuix.kmp.glass,
        top.yukonga.miuix.kmp.material
    " />

<application
        android:name=".App"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:fullBackupContent="@xml/backup_rules"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MTForum"
        android:enableOnBackInvokedCallback="true"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="37">

        <activity
            android:name="io.rune.mt.forum.ui.activity.SettingsActivity"
            android:exported="true"
            android:enableOnBackInvokedCallback="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!--
                论坛链接深链。只声明可被选择（DEFAULT + BROWSABLE），不声明 autoVerify：
                站点无法由本仓库发布 assetlinks.json，宣称 App Links 验证只会让 Android 12+
                把该域名判为验证失败。查询参数（mod/tid/fid）在代码里解析。
            -->
            <!-- 帖子：https://bbs.binmt.cc/thread-<tid>-<page>-<author>.html -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="bbs.binmt.cc"
                    android:pathPattern="/thread-.*\.html" />
            </intent-filter>
            <!-- 版块：https://bbs.binmt.cc/forum-<fid>-<page>.html -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="bbs.binmt.cc"
                    android:pathPattern="/forum-.*\.html" />
            </intent-filter>
            <!-- Discuz 查询形态：https://bbs.binmt.cc/forum.php?mod=viewthread&tid=... -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="bbs.binmt.cc"
                    android:path="/forum.php" />
            </intent-filter>
            <!-- 自定义 scheme：mtforum://thread/<tid> -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="mtforum"
                    android:host="thread" />
            </intent-filter>
            <!-- 自定义 scheme：mtforum://forum/<fid> -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="mtforum"
                    android:host="forum" />
            </intent-filter>
            <!--
                首页：mtforum://home（解析为 Route.Main 的 论坛 页签）。
                网页形态 https://bbs.binmt.cc/forum.php 已由上方的 forum.php 过滤器覆盖，
                查询参数由 ForumDeepLink 解析，这里不再单独声明。
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="mtforum"
                    android:host="home" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name="io.rune.mt.forum.ui.activity.LauncherAlias"
            android:targetActivity="io.rune.mt.forum.ui.activity.SettingsActivity"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 仅保留唯一 Activity（设置入口）；安装器相关 Activity/入口已移除。 -->

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    
        <activity
            android:name="io.rune.mt.forum.core.crash.CrashActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true" />
    </application>

</manifest>
