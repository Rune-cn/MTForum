<?xml version="1.0" encoding="utf-8"?>
<!--
  MT 论坛 launcher foreground.

  A simple sitting cat in the bottom-left of the 108dp canvas: head + two ears, a sitting body
  and one raised tail. Flat and single-tone by design, so the identical art doubles as the
  Android 13+ themed (monochrome) layer; the top-right quadrant is left empty on purpose so the
  icon stays calm where launchers put badges and counters.

  Safe zone: adaptive icons are cropped to a 66dp circle (r = 33dp around 54,54). The cat's
  farthest pixel is ~30.6dp from the centre (the raised tail's shoulder), i.e. 2.4dp of margin,
  so nothing is clipped by a round mask. Verified by LauncherIconTest.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- body: a wedge-shaped sit — rump on the left, chest and front paw on the right -->
    <path
        android:fillColor="#FF4ADE80"
        android:pathData="M37.6,52.6C34.4,55.6 32.6,60.6 32.2,65.4C31.7,70.2 33.2,74.6 37.0,76.2C41.2,78.0 46.4,78.3 49.9,77.9C52.1,77.6 53.3,76.1 53.3,73.7L53.4,66.0C53.5,61.6 51.2,57.6 47.8,56.0L49.6,52.6Z" />

    <!-- ears: two triangles whose bases tuck under the head, so the union reads as one silhouette -->
    <path
        android:fillColor="#FF4ADE80"
        android:pathData="M35.4,36.2L41.6,39.6L34.6,44.6Z" />
    <path
        android:fillColor="#FF4ADE80"
        android:pathData="M51.4,36.0L45.0,39.6L51.8,44.6Z" />

    <!-- head: a wide, shallow oval — friendlier than a circle at 48dp -->
    <path
        android:fillColor="#FF4ADE80"
        android:pathData="M43.2,38.6C48.61,38.6 53.0,42.6 53.0,47.5C53.0,52.4 48.61,56.4 43.2,56.4C37.79,56.4 33.4,52.4 33.4,47.5C33.4,42.6 37.79,38.6 43.2,38.6Z" />

    <!-- tail: curls up behind the rump; the tip is left free so it never closes into a "handle" ring -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF4ADE80"
        android:strokeWidth="5.4"
        android:strokeLineCap="round"
        android:pathData="M33.0,71.4C28.6,68.2 27.0,61.8 29.8,57.2C30.2,56.6 30.5,56.2 31.0,55.8" />
</vector>
