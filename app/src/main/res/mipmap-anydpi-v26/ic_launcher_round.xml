<?xml version="1.0" encoding="utf-8"?>
<!--
  Round-mask variant. Same three layers as ic_launcher.xml; the system applies the shape. The face
  (ears, eyes, whiskers) already sits inside the 72dp window every mask keeps, so nothing needs a
  different inset here; only the body runs off the bottom-left edge by design.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
